# Chép file này thành .env rồi sửa giá trị
PORT=3000

# Bí mật ký JWT — ĐỔI thành chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32)
JWT_SECRET=please-change-this-to-a-long-random-string

# Đường dẫn file SQLite (mặc định server/data.db)
DB_PATH=./data.db

# CORS: danh sách origin được phép, cách nhau bằng dấu phẩy. Để trống = cho phép tất cả (tiện dev).
# Khi deploy nên đặt đúng origin trang Bluefy, vd: https://tuna195.github.io
CORS_ORIGIN=
